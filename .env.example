# Never commit real API keys, tokens, or passwords.

FA_APP_NAME=Freelance Agents
FA_ENVIRONMENT=development
FA_DEBUG=false
FA_LOG_LEVEL=INFO
FA_DATABASE_URL=sqlite+aiosqlite:///./data/freelance_agents.db

# Optional placeholder for a future integration. Leave empty for the current MVP.
FA_TELEGRAM_BOT_TOKEN=

# Set all three to enable the AI completion provider; leave empty to start
# the application without one.
FA_AI_API_KEY=
FA_AI_BASE_URL=
FA_AI_MODEL=
FA_AI_TIMEOUT_SECONDS=30
FA_AI_MAX_RETRIES=2
